# =====================================================================
# soybean_django 后端环境变量模板
# 使用方法:
#   1. 复制本文件为 .env (放在 backend/ 目录，与 manage.py 同级)
#        cp backend/.env.example backend/.env
#   2. 根据实际情况修改 .env 里的值
#   3. .env 已在 .gitignore 中，不会入库
# =====================================================================

# ---------------------------------------------------------------------
# 1. Django 通用
# ---------------------------------------------------------------------
# Django 密钥: 生产环境必须改! 可以用下面命令生成:
#     python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-string-please

# 开发用 True; 生产必须 False
DJANGO_DEBUG=True

# 允许的 HOST, 用英文逗号分隔; 生产建议写具体域名
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 国际化
DJANGO_LANGUAGE_CODE=zh-hans
DJANGO_TIME_ZONE=Asia/Shanghai


# ---------------------------------------------------------------------
# 2. 数据库 (三选一, 通过 DB_ENGINE 切换)
# ---------------------------------------------------------------------
# DB_ENGINE 可选值:
#   sqlite3      默认, 无需额外驱动
#   mysql        需要安装 mysqlclient; 对应 pip install mysqlclient
#   postgresql   需要安装 psycopg2-binary; 对应 pip install psycopg2-binary
DB_ENGINE=sqlite3

# -- sqlite3 模式下, 以下字段会被忽略, 直接使用 backend/db.sqlite3
# -- mysql / postgresql 模式下, 需要填写下面连接信息 --

DB_HOST=127.0.0.1
DB_PORT=3306              # MySQL 默认 3306; PostgreSQL 改成 5432
DB_NAME=soybean_django
DB_USER=root
DB_PASSWORD=123456
# MySQL 额外: 字符集 / 事务隔离级别 (可选, 留空用默认)
DB_OPTIONS_CHARSET=utf8mb4


# ---------------------------------------------------------------------
# 3. Redis (可选; 配置后会接管 CACHES.default)
# ---------------------------------------------------------------------
# 两种配置方式, 任选其一 (优先使用 REDIS_URL)
#   A. 完整 URL:
#        redis://:password@host:port/db
#        示例 (无密码, 0号库): redis://127.0.0.1:6379/0
#   B. 拆分字段 (REDIS_URL 留空时生效):
#        REDIS_HOST / REDIS_PORT / REDIS_DB / REDIS_PASSWORD
REDIS_URL=

# 当 REDIS_URL 留空时使用下列字段
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# Redis key 前缀, 避免多项目共用 Redis 时冲突
REDIS_KEY_PREFIX=soybean_django:
