# backend service base url, test environment
# dev 下 VITE_HTTP_PROXY=Y 会走 /proxy-default → target，rewrite 掉 /proxy-default
# 因此 target 必须到 Django /api 前缀根，才能让前端请求 /auth/login → 真实 /api/auth/login
VITE_SERVICE_BASE_URL=http://localhost:8000/api

# other backend service base url, test environment
# 注意：.env 不支持多行值，必须写成单行，否则 json5.parse 报错
VITE_OTHER_SERVICE_BASE_URL={"demo":"http://localhost:9528"}

# auth route mode: static ｜ dynamic
# 切 dynamic：路由菜单树由 Django /api/route/getUserRoutes 按当前用户角色返回
VITE_AUTH_ROUTE_MODE=dynamic
